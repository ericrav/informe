{
  "name": "informe",
  "type": "module",
  "version": "0.0.1",
  "description": "Formless input for evolving apps",
  "author": "Eric Rabinowitz <er@ericrabinowitz.com>",
  "license": "MIT",
  "homepage": "https://github.com/ericrav/informe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericrav/informe.git"
  },
  "bugs": {
    "url": "https://github.com/ericrav/informe/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./style.css": {
      "import": "./src/style.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "demo": "pnpm --filter informe-demo dev",
    "demo:build": "pnpm --filter informe-demo build",
    "dev": "concurrently \"pnpm demo\" \"tsdown --watch\"",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@11.0.0+sha512.5bd187500e49cc6c3d891d973b432c02b844a5eb7209172c90a517a3ef4f579ed5c23d409b699e6a9dc418ff7b2b1890e63f6d74f1d3fc49848f37779c89c84c",
  "dependencies": {
    "fractional-indexing": "^3.2.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8"
  }
}
